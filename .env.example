# Firebase project config (Firebase console -> Project settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of emails that get the Admin role.
# These must also exist as Firebase Authentication users (email/password).
VITE_ADMIN_EMAILS=admin@yourschool.com
